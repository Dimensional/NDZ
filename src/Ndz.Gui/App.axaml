<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ndz.Gui.App"
             xmlns:local="using:Ndz.Gui">
             <!-- RequestedThemeVariant is no longer set here - ThemeService.Initialize()
                  (called from App.axaml.cs, before the main window is created) sets it at
                  runtime based on the user's persisted Light/Dark/System/Signature choice,
                  and also merges the matching Themes/*.axaml color-token dictionary into
                  Application.Resources - see ThemeService's own remarks. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>