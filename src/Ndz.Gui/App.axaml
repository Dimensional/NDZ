<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ndz.Gui.App"
             xmlns:local="using:Ndz.Gui"
             RequestedThemeVariant="Dark">
             <!-- Forced dark: every card/control in this app is hand-styled against a fixed
                  dark palette (the "Signature" theme from the design mockups) - Light/System
                  switching isn't implemented yet, so this at least keeps FluentTheme-templated
                  controls we don't hand-style ourselves (ComboBox's popup, scrollbars) from
                  clashing against it on a light-mode system. Revisit once real theming lands. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>