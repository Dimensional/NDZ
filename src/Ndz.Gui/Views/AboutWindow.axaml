<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Ndz.Gui.Views"
        x:Class="Ndz.Gui.Views.AboutWindow"
        x:DataType="views:AboutWindow"
        Width="360" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Title="About NDZ Forge">

    <!-- Styled inline rather than via Classes="ghost" - that style lives in MainWindow's
         own Window.Styles (window-local, not shared across windows), and this window is
         simple enough not to need a whole shared-styles setup just for one button. -->
    <StackPanel Margin="24" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="NDZ Forge" Foreground="{DynamicResource Text.Primary}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource Text.Muted}" FontSize="11.5" HorizontalAlignment="Center"/>
        <TextBlock Text="A Pack/Examine GUI for the NDZ compression format - built on top of Ndz.Core." Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock Text="NDZ format by Mena Azer." Foreground="{DynamicResource Text.Muted}" FontSize="11" HorizontalAlignment="Center"/>
        <Button Content="Close" Click="OnCloseClicked" HorizontalAlignment="Center" Margin="0,8,0,0"
                Background="Transparent" BorderBrush="{DynamicResource Border.Ghost}" BorderThickness="1"
                CornerRadius="7" Foreground="{DynamicResource Text.Primary}" Padding="14,7" FontWeight="SemiBold"/>
    </StackPanel>
</Window>
