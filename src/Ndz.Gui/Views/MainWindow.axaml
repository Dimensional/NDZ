<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ndz.Gui.ViewModels"
        xmlns:m="using:Ndz.Gui.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Ndz.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="640"
        Background="#14161A"
        Title="NDZ Forge">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Foreground" Value="#E8EAEE"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C1F26"/>
        </Style>
        <Style Selector="Button.iconbtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#262A33"/>
            <Setter Property="TextBlock.Foreground" Value="#E5636B"/>
        </Style>
        <Style Selector="Button.chipx">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.chipx:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="#E5636B"/>
        </Style>
        <Style Selector="Button.targetstrip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#363B46"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.targetstrip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20242D"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#14161A"/>
            <Setter Property="BorderBrush" Value="#2C303A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Foreground" Value="#E8EAEE"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5C8DF6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4E7DE0"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C303A"/>
            <Setter Property="TextBlock.Foreground" Value="#6B7280"/>
        </Style>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A90A0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="#C7CCD4"/>
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground" Value="#E8EAEE"/>
            <Setter Property="BorderBrush" Value="#5C8DF6"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="52,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="#181A20" BorderBrush="#2C303A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="18,0">
                <TextBlock Grid.Column="0" Text="NDZ Forge" Foreground="#E8EAEE" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Stretch">
                    <Button Classes="tab" Classes.active="{Binding !ShowExamine}" Content="Pack" Command="{Binding ShowPackTabCommand}" VerticalAlignment="Stretch"/>
                    <Button Classes="tab" Classes.active="{Binding ShowExamine}" Content="Examine" Command="{Binding ShowExamineTabCommand}" VerticalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ShowExamine}">
                    <Button Classes="ghost" Content="Add Folder…" Click="OnAddFolderClicked" VerticalAlignment="Center"/>
                    <Button Classes="ghost" Content="Open ROM…" Click="OnOpenRomClicked" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowExamine}">
                    <Button Classes="ghost" Content="Add Folder…" Click="OnExamineAddFolderClicked" VerticalAlignment="Center"/>
                    <Button Classes="ghost" Content="Open File…" Click="OnExamineOpenFileClicked" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Name="DropZone" Background="Transparent">
            <Grid>

            <!-- Pack tab -->
            <Grid IsVisible="{Binding !ShowExamine}">

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !HasItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="52" Height="52" CornerRadius="26" BorderBrush="#454B58" BorderThickness="1.5" HorizontalAlignment="Center">
                        <TextBlock Text="+" FontSize="22" Foreground="#8A90A0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                    </Border>
                    <TextBlock Text="Drag .nds/.dsi ROMs or folders here" Foreground="#C7CCD4" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="folders are searched recursively — drop more anytime" Foreground="#6B7280" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Queue grid -->
                <ScrollViewer IsVisible="{Binding HasItems}" Padding="20">
                    <ItemsControl ItemsSource="{Binding QueueItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RomEntryViewModel">
                                <!-- Tag identifies this as a valid "add as target" drop zone for code-behind's
                                     drop hit-test - the WHOLE card counts, not just the strip below, so a drop
                                     doesn't have to land on one thin line to be recognized. -->
                                <Border Tag="RomCard" Width="240" Margin="0,0,14,14" Background="#1C1F26" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="10" Padding="14" ToolTip.Tip="{Binding TooltipText}">
                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="48" Height="48" Background="#14161A" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="8">
                                                <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,4,0" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShortTitle}" Foreground="#E8EAEE" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Border Background="#14161A" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="5" Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding GameCode}" Foreground="#9AA1AD" FontFamily="Consolas,Menlo,monospace" FontSize="10.5"/>
                                                    </Border>
                                                    <Border IsVisible="{Binding HasRevision}" Background="#14161A" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="5" Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding RevisionText}" Foreground="#9AA1AD" FontFamily="Consolas,Menlo,monospace" FontSize="10.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="iconbtn" Command="{Binding RemoveCommand}" VerticalAlignment="Top" Content="✕" FontSize="10"/>
                                        </Grid>

                                        <Border IsVisible="{Binding IsDuplicate}" Background="#2B1F14" BorderBrush="#E0A94D" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                            <TextBlock Text="Already in queue" Foreground="#E0A94D" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Target chips - this card's patch targets, if any. A plain vertical
                                             StackPanel (not a WrapPanel) so each chip stretches to the card's full
                                             content width instead of hugging its own content and leaving a gap -
                                             the title column below absorbs whatever space the icon/dropdown/remove
                                             button don't need. -->
                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RomEntryViewModel">
                                                    <Border Background="#22262F" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="8" Padding="6,5" ToolTip.Tip="{Binding TooltipText}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                            <Border Grid.Column="0" Width="20" Height="20" Background="#14161A" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="3">
                                                                <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding ShortTitle}" Foreground="#C7CCD4" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <!-- This target's own dictionary size, independent of the base's and every
                                                                 other target's (block size is shared across the whole pack, so no
                                                                 per-target block-size control here). -->
                                                            <ComboBox Grid.Column="2" ItemsSource="{Binding DictionarySizeOptions}" SelectedItem="{Binding SelectedDictionarySize}"
                                                                      FontSize="9" Padding="5,2" Width="64" HorizontalContentAlignment="Center" VerticalAlignment="Center">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="m:SizeOption">
                                                                        <TextBlock Text="{Binding Label}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="3" Classes="chipx" Command="{Binding RemoveCommand}" Content="✕" FontSize="8" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Drop a fresh ROM anywhere on this card, or click to browse - both add it as this card's patch target. DataContext here is this card's own RomEntryViewModel (inherited). -->
                                        <Button Classes="targetstrip" Click="OnAddTargetClicked">
                                            <TextBlock Text="+ drop a ROM here or click to browse" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </Button>

                                        <TextBlock Text="{Binding PlatformText}" Foreground="#6B7280" FontSize="10.5" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding BannerNote}" IsVisible="{Binding HasBannerNote}" Foreground="#6B7280" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SourceFileText}" Foreground="#6B7280" FontSize="10.5" FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis"/>

                                        <Border Height="1" Background="#262A33"/>

                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                <TextBlock Text="DICTIONARY" Foreground="#6B7280" FontSize="9.5" FontWeight="Bold"/>
                                                <ComboBox ItemsSource="{Binding DictionarySizeOptions}" SelectedItem="{Binding SelectedDictionarySize}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="m:SizeOption">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                <TextBlock Text="BLOCK SIZE" Foreground="#6B7280" FontSize="9.5" FontWeight="Bold"/>
                                                <ComboBox ItemsSource="{Binding BlockSizeOptions}" SelectedItem="{Binding SelectedBlockSize}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="m:SizeOption">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Button Classes="ghost" Content="{Binding AnalyzeButtonText}" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                                        <Border IsVisible="{Binding HasAnalysisResult}" Background="#14261C" BorderBrush="#2F6B47" BorderThickness="1" CornerRadius="7" Padding="8,6">
                                            <TextBlock Text="{Binding AnalysisResultText}" Foreground="#4FBE83" FontSize="10.5" TextWrapping="Wrap"/>
                                        </Border>
                                        <Border IsVisible="{Binding HasAnalysisError}" Background="#2B1414" BorderBrush="#E5636B" BorderThickness="1" CornerRadius="7" Padding="8,6">
                                            <TextBlock Text="{Binding AnalysisError}" Foreground="#E5636B" FontSize="10.5" TextWrapping="Wrap"/>
                                        </Border>

                                        <Button Classes="primary" Content="{Binding PackButtonText}" Click="OnPackClicked" IsEnabled="{Binding !IsPacking}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                                        <Border IsVisible="{Binding HasPackResult}" Background="#14261C" BorderBrush="#2F6B47" BorderThickness="1" CornerRadius="7" Padding="8,6">
                                            <TextBlock Text="{Binding PackResultText}" Foreground="#4FBE83" FontSize="10.5" TextWrapping="Wrap"/>
                                        </Border>
                                        <Border IsVisible="{Binding HasPackError}" Background="#2B1414" BorderBrush="#E5636B" BorderThickness="1" CornerRadius="7" Padding="8,6">
                                            <TextBlock Text="{Binding PackError}" Foreground="#E5636B" FontSize="10.5" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}"
                        Background="#2B1F14" BorderBrush="#E0A94D" BorderThickness="1" CornerRadius="7"
                        Padding="12,8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="20">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E0A94D" FontSize="12" TextWrapping="Wrap"/>
                </Border>

            </Grid>

            <!-- Examine tab -->
            <Grid IsVisible="{Binding ShowExamine}">
            <Grid DataContext="{Binding Examine}">

                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !HasItems}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="52" Height="52" CornerRadius="26" BorderBrush="#454B58" BorderThickness="1.5" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drag .ndz / .nds / .dsi files or folders here" Foreground="#C7CCD4" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="pair containers show every bundled ROM · folders are searched recursively" Foreground="#6B7280" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Source list -->
                <ScrollViewer IsVisible="{Binding HasItems}" Padding="20">
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExamineSourceViewModel">
                                <Border Background="#1C1F26" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" Foreground="#E8EAEE" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding HeaderText}" Foreground="#6B7280" FontSize="10.5"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="iconbtn" Click="OnRemoveSourceClicked" VerticalAlignment="Top" Content="✕" FontSize="10"/>
                                        </Grid>

                                        <Border Height="1" Background="#262A33"/>

                                        <!-- One row per bundled ROM - just one for a single .ndz or a raw ROM, N for a pair container. -->
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ExamineEntryViewModel">
                                                    <Border Background="#22262F" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="8" Padding="8" ToolTip.Tip="{Binding TooltipText}">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <Border Grid.Column="0" Width="36" Height="36" Background="#14161A" BorderBrush="#2C303A" BorderThickness="1" CornerRadius="6">
                                                                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="10,0,4,0" Spacing="3" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding ShortTitle}" Foreground="#E8EAEE" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding GameCode}" Foreground="#9AA1AD" FontFamily="Consolas,Menlo,monospace" FontSize="10"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding SummaryText}" Foreground="#8A90A0" FontSize="10.5" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Classes="ghost" Content="{Binding UnpackButtonText}" Click="OnUnpackClicked" IsVisible="{Binding CanUnpack}" IsEnabled="{Binding !IsUnpacking}" VerticalAlignment="Center" FontSize="11" Padding="10,5"/>
                                                            </Grid>

                                                            <Border IsVisible="{Binding HasUnpackResult}" Background="#14261C" BorderBrush="#2F6B47" BorderThickness="1" CornerRadius="7" Padding="7,5">
                                                                <TextBlock Text="{Binding UnpackResultText}" Foreground="#4FBE83" FontSize="10.5" TextWrapping="Wrap"/>
                                                            </Border>
                                                            <Border IsVisible="{Binding HasUnpackError}" Background="#2B1414" BorderBrush="#E5636B" BorderThickness="1" CornerRadius="7" Padding="7,5">
                                                                <TextBlock Text="{Binding UnpackError}" Foreground="#E5636B" FontSize="10.5" TextWrapping="Wrap"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}"
                        Background="#2B1F14" BorderBrush="#E0A94D" BorderThickness="1" CornerRadius="7"
                        Padding="12,8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="20">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E0A94D" FontSize="12" TextWrapping="Wrap"/>
                </Border>

            </Grid>
            </Grid>

            </Grid>
        </Border>
    </Grid>

</Window>
